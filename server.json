{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "codes.qrx/mcp",
  "title": "QRX",
  "description": "Turn a prompt and a link into a branded, print-ready QR code that always scans.",
  "version": "1.2.2",
  "websiteUrl": "https://qrx.codes/developers",
  "repository": {
    "url": "https://github.com/qrxcodes/qrx-mcp",
    "source": "github",
    "id": "1410735001"
  },
  "icons": [
    {
      "src": "https://qrx.codes/images/brand/qrx-code-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://qrx.codes/images/brand/qrx-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@qrxcodes/mcp",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "QRX_API_KEY",
          "description": "Your QRX API key (starts with qrx_). Create one at https://qrx.codes/developers/keys. The server needs it to connect.",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "placeholder": "qrx_..."
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://qrx.codes/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. Connecting needs sign-in or an API key. Clients that support MCP sign-in (OAuth) need no header; otherwise send your QRX API key from https://qrx.codes/developers/keys as a bearer token.",
          "value": "Bearer {qrx_api_key}",
          "isRequired": false,
          "isSecret": true,
          "variables": {
            "qrx_api_key": {
              "description": "QRX API key (starts with qrx_). Create one at https://qrx.codes/developers/keys.",
              "placeholder": "qrx_...",
              "isRequired": false,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "codes.qrx": {
        "docs": "https://qrx.codes/developers/mcp",
        "llmsTxt": "https://qrx.codes/llms.txt",
        "auth": [
          "oauth",
          "api-key"
        ],
        "tools": [
          "generate_qr_code",
          "get_qr_code",
          "list_qr_codes",
          "change_qr_code_destination",
          "get_account",
          "get_profile",
          "list_styles"
        ]
      }
    }
  }
}
